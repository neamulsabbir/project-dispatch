{
  "name": "project-dispatch",
  "displayName": "Project Dispatch",
  "description": "See every open VS Code or Cursor window, pick projects, and run a command in each selected terminal.",
  "version": "0.4.4",
  "icon": "media/extensionicon.png",
  "publisher": "neamulsabbir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neamulsabbir/project-dispatch"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectRunner",
          "title": "Project Dispatch",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "projectRunner": [
        {
          "type": "webview",
          "id": "projectRunner.panel",
          "name": "Projects",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "projectRunner.refresh",
        "title": "Project Dispatch: Refresh Projects"
      }
    ],
    "configuration": {
      "title": "Project Dispatch",
      "properties": {
        "projectRunner.splitTerminals": {
          "type": "boolean",
          "default": true,
          "description": "When multiple selected projects belong to the same window, open their terminals side by side."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.6.3"
  }
}


